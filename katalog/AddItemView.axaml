<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="katalog.AddItemView">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <TextBlock Text="Dodaj nową pozycję" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Wprowadź dane nowej pozycji, aby zapisać ją w katalogu" Foreground="Gray" />
        </StackPanel>

        <!-- Formularz -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <!-- Tytuł -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Tytuł:" FontWeight="Bold" Foreground="#333333" />
                    <TextBox Name="TitleTextBox" PlaceholderText="np. Matrix" />
                </StackPanel>

                <!-- Rok wydania -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Rok wydania:" FontWeight="Bold" Foreground="#333333" />
                    <TextBox Name="YearTextBox" PlaceholderText="np. 1999" />
                </StackPanel>

                <!-- Ocena -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Ocena (liczba 1-10):" FontWeight="Bold" Foreground="#333333" />
                    <TextBox Name="RatingTextBox" PlaceholderText="np. 9" />
                </StackPanel>

                <!-- Komunikat walidacji -->
                <TextBlock Name="StatusTextBlock" Foreground="Red" FontWeight="SemiBold" Text="" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- Pasek akcji -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Content="Anuluj" Click="OnCancelClick" Background="#6C757D" Foreground="White" Padding="20,10" />
            <Button Content="Zapisz do katalogu" Click="OnSaveClick" Background="#28A745" Foreground="White" Padding="20,10" />
        </StackPanel>
    </Grid>
</UserControl>
